@Domain
var User {
  @id(uuid)                                  userId
  @validator(notEmpty, size(min: 8), unique) userName
  @validator(notEmpty, size(min: 2))         firstName
  @secret                                    password
}

@Database(User, "users") {
  crud
  query login(userName, password): verify
  query existsByUserName(userName): exists
}
